# Backend Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:8080

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-secret-key-here-change-in-production

# AWS Configuration
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# DynamoDB Configuration
# Local development
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=eu-west-3

# Production (comment out DYNAMODB_ENDPOINT for AWS DynamoDB)
# DYNAMODB_ENDPOINT=
# DYNAMODB_REGION=eu-west-3

# Table names
TABLE_USERS=we-counsel-users
TABLE_COUPLES=we-counsel-couples
TABLE_CONVERSATIONS=we-counsel-conversations
TABLE_MESSAGES=we-counsel-messages
TABLE_SUBSCRIPTIONS=we-counsel-subscriptions

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Email Service (AWS SES)
SES_SENDER_EMAIL=noreply@your-domain.com
SES_REGION=eu-west-3

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (get these from Stripe Dashboard)
STRIPE_PRICE_ESSENTIAL_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ESSENTIAL_ANNUAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_ANNUAL=price_xxxxxxxxxxxxx

# Google Marketing CLI
# Auth can use GOOGLE_ACCESS_TOKEN, OAuth refresh-token credentials, or local gcloud auth.
GOOGLE_ADS_API_VERSION=v24
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://we-connect-app.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
PAGESPEED_API_KEY=

# AWS Secrets Manager (for production)
USE_AWS_SECRETS=false
AWS_SECRETS_NAME=we-counsel/production

# Test Mode
ENABLE_TEST_ENDPOINTS=true
USE_MOCK_EMAIL=true
USE_MOCK_AI=true
